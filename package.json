{
  "name": "spot-buddy-monorepo",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "http-errors": "2.0.0",
    "tailwindcss": "3.3.2",
    "nativewind": {
      "tailwindcss": "3.3.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@spot-buddy/mobile",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
