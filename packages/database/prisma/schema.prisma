generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum Day {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

enum BodyPart {
    CHEST
    BACK
    LEGS
    SHOULDERS
    BICEPS
    TRICEPS
    CORE
    FULL_BODY
}

model User {
    id             String   @id @default(cuid())
    email          String   @unique
    name           String
    dob            DateTime
    hashedPassword String
    preferredChart String   @default("RVI")

    // fastapi-users compatibility fields
    isActive    Boolean @default(true)
    isSuperuser Boolean @default(false)
    isVerified  Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    plans Plan[]

    @@map("user")
}

model Plan {
    id        String     @id @default(cuid())
    day       Day
    bodyParts BodyPart[]
    userId    String
    user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    exercises Exercise[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, day])
    @@map("plan")
}

model Exercise {
    id         String   @id @default(cuid())
    name       String
    bodyPart   BodyPart
    isStandard Boolean  @default(false)

    plans Plan[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("exercise")
}
