{
  "expo": {
    "name": "Spot Buddy",
    "slug": "spot-buddy",
    "scheme": "spot-buddy",
    "version": "1.0.0",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
